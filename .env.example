# docker compose / Portainer stack environment for herdr-ui
# The host user that runs herdr — its home holds the herdr socket, ~/.claude and ~/.ssh.
HOST_HOME=/home/you
UID=1000
GID=1000
# Optional. Unset: a token is generated into ${HOST_HOME}/.config/herdr-ui/token on first run.
HERDR_UI_TOKEN=
# Optional. Mounted read-only at the same path so the file viewer and git diff can read it.
PROJECTS=/home/you/Projects
